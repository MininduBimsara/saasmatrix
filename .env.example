# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Lemon Squeezy Configuration (Server Side - Secret Key / API Key)
LEMON_SQUEEZY_API_KEY=

# Lemon Squeezy Store ID & Variant ID Indices
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_FOUNDER_PRO=
LEMON_SQUEEZY_VARIANT_ENTERPRISE_BUYER=

# Supabase Authentication & Database Integration (Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY can be used instead of ANON_KEY in newer Supabase dashboards.

# Admin access is handled exclusively via Supabase Auth.
# Create your admin user directly in the Supabase dashboard (Authentication → Users).
# Then set role = 'admin' in the user's raw_user_meta_data to enable write access via RLS.

# Upstash Redis — required for API rate limiting on /api/lemonsqueezy/checkout
# Create a free database at https://console.upstash.com and copy the REST credentials.
# If these are absent, rate limiting is silently skipped (safe for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google AdSense Ads configuration (toggle off to hide empty placeholder boxes and prevent script loading)
NEXT_PUBLIC_ADS_ENABLED=false
